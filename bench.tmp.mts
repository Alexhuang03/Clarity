import { createClient } from "@supabase/supabase-js";
import { processDocument } from "@/lib/ingest/pipeline";
const admin = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SECRET_KEY!, { auth: { persistSession: false } });
const { data: original } = await admin.from("documents").select("storage_path, filename").like("filename", "GenAI%").order("created_at", { ascending: false }).limit(1).single();
const { data: file } = await admin.storage.from("documents").download(original!.storage_path);
const { data: u } = await admin.auth.admin.createUser({ email: "bench@clarity.local", password: "Clarity2026", email_confirm: true });
const uid = u.user!.id;
const { data: course } = await admin.from("courses").insert({ user_id: uid, title: "bench" }).select().single();
const path = `${uid}/${course.id}/bench.pdf`;
await admin.storage.from("documents").upload(path, file!, { contentType: "application/pdf" });
const { data: doc } = await admin.from("documents").insert({ user_id: uid, course_id: course.id, storage_path: path, filename: original!.filename, mime_type: "application/pdf" }).select().single();
const t = Date.now();
const log = console.info;
console.info = (...a: unknown[]) => log(`  [${((Date.now() - t) / 1000).toFixed(0)}s]`, ...a);
console.warn = (...a: unknown[]) => log(`  [${((Date.now() - t) / 1000).toFixed(0)}s] ⚠️`, ...a);
await processDocument(doc.id);
const { data: done } = await admin.from("documents").select("status, page_count, error").eq("id", doc.id).single();
const { data: chunks } = await admin.from("chunks").select("content, embedding").eq("document_id", doc.id);
log(`TOTAL : ${((Date.now() - t) / 1000).toFixed(0)}s, ${done!.status}, ${done!.page_count} pages, ${chunks!.length} morceaux, embeddings complets : ${chunks!.every((c) => c.embedding)}${done!.error ? ", erreur " + done!.error : ""}`);
await admin.storage.from("documents").remove([path]);
await admin.auth.admin.deleteUser(uid);
